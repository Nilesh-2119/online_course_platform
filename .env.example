# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit real secrets.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=course_platform_db
DB_USERNAME=root
DB_PASSWORD=root

# Connection Pool (HikariCP)
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=15

# Security & JWT Configuration
JWT_SECRET=your_base64_encoded_256bit_minimum_secret_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH2_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_WINDOW=5

# Delivery Providers
EMAIL_OTP_ENABLED=true
SMS_OTP_ENABLED=true
EMAIL_PROVIDER_API_KEY=placeholder_email_api_key
SMS_PROVIDER_API_KEY=placeholder_sms_api_key

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Video Security & Playback (VdoCipher)
VDOCIPHER_API_SECRET=placeholder_vdocipher_secret
VDOCIPHER_OTP_TTL=300
VDOCIPHER_WHITELIST_URL=

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,info
